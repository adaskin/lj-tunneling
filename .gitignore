## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.env

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs





# Files built by Visual Studio
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.idb
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp


# ljtunnel: the run logs ARE data (provenance of every stored result); keep them
!data/logs/
!data/logs/*.log
!data/legacy/**/*.log
!data/legacy/**/logs/
!data

# LaTeX build files
paper/*.aux
paper/*.blg
paper/*.out
paper/*.toc

#pycache
ljtunnel/__pycache__
ljtunnel/*/__pycache__
__pycache__
notebooks/__pycache__
tests/__pycache__
paper/__pycache__
# scratch of the full rerun (rerun_all.sh): checkpoints of a running job (removed when it completes) and the scheduler state.
# Every log and data file is tracked.
data/ckpt/
data/rerun/state/
paper/*.fls
paper/*.fdb_latexmk
paper/*.log
